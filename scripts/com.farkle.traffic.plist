<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.farkle.traffic</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ariatron/farkle-fun/scripts/continuous-traffic.sh</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ariatron/farkle-fun</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ariatron/farkle-fun/logs/traffic-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ariatron/farkle-fun/logs/traffic-stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
