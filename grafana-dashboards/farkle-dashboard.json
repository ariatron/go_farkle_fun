{
  "dashboard": {
    "title": "Farkle Game Observability",
    "tags": ["farkle", "game", "observability"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(farkle_http_requests_total[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 2,
        "title": "HTTP Request Latency (P95)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(farkle_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} (p95)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(farkle_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} (p99)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total Requests",
        "type": "stat",
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(farkle_http_requests_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "stat",
        "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(farkle_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(farkle_http_requests_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Average Response Time",
        "type": "stat",
        "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "rate(farkle_http_request_duration_seconds_sum[5m]) / rate(farkle_http_request_duration_seconds_count[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "red", "value": 0.5 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Active Games",
        "type": "stat",
        "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "farkle_active_games",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "blue", "value": null }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Game Events Rate",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(farkle_game_rolls_total[5m])",
            "legendFormat": "Rolls/sec",
            "refId": "A"
          },
          {
            "expr": "rate(farkle_game_banks_total[5m])",
            "legendFormat": "Banks/sec",
            "refId": "B"
          },
          {
            "expr": "rate(farkle_game_farkles_total[5m])",
            "legendFormat": "Farkles/sec",
            "refId": "C"
          },
          {
            "expr": "rate(farkle_game_wins_total[5m]) * 60",
            "legendFormat": "Wins/min",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Farkle Rate",
        "type": "gauge",
        "gridPos": { "x": 12, "y": 12, "w": 6, "h": 8 },
        "targets": [
          {
            "expr": "rate(farkle_game_farkles_total[5m]) / rate(farkle_game_rolls_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 50,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 20 },
                { "color": "red", "value": 40 }
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Total Game Stats",
        "type": "stat",
        "gridPos": { "x": 18, "y": 12, "w": 6, "h": 8 },
        "targets": [
          {
            "expr": "farkle_game_rolls_total",
            "legendFormat": "Total Rolls",
            "refId": "A"
          },
          {
            "expr": "farkle_game_banks_total",
            "legendFormat": "Total Banks",
            "refId": "B"
          },
          {
            "expr": "farkle_game_farkles_total",
            "legendFormat": "Total Farkles",
            "refId": "C"
          },
          {
            "expr": "farkle_game_wins_total",
            "legendFormat": "Total Wins",
            "refId": "D"
          }
        ],
        "options": {
          "orientation": "vertical"
        }
      },
      {
        "id": 10,
        "title": "Points Distribution (Roll)",
        "type": "histogram",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(farkle_points_distribution_bucket{type=\"roll\"}[5m])) by (le)",
            "format": "heatmap",
            "refId": "A"
          }
        ]
      },
      {
        "id": 11,
        "title": "Points Distribution (Bank)",
        "type": "histogram",
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(rate(farkle_points_distribution_bucket{type=\"bank\"}[5m])) by (le)",
            "format": "heatmap",
            "refId": "A"
          }
        ]
      },
      {
        "id": 12,
        "title": "Response Size Distribution",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(farkle_http_response_size_bytes_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} (p50)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(farkle_http_response_size_bytes_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} (p95)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 13,
        "title": "HTTP Status Codes",
        "type": "piechart",
        "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum(farkle_http_requests_total) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": false
}
