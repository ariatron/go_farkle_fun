# Grafana Cloud Configuration
# Copy this file to .env and fill in your Grafana Cloud credentials

# Enable/disable Grafana Cloud integration
GRAFANA_CLOUD_ENABLED=false

# Your Grafana Cloud Stack Details
# Get these from: https://grafana.com/orgs/YOUR_ORG/stacks
GRAFANA_CLOUD_STACK_NAME=mystack
GRAFANA_CLOUD_REGION=us-central1  # or prod-us-east-0, etc.

# Prometheus (Metrics)
# From: Stack → Prometheus → Details → Remote Write Endpoint
PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-us-central1.grafana.net/api/prom/push
PROMETHEUS_REMOTE_WRITE_USERNAME=123456  # Your instance/user ID
PROMETHEUS_REMOTE_WRITE_PASSWORD=glc_xxxxxxxxxxxxx  # Your API key

# Tempo (Traces)
# From: Stack → Tempo → Details
TEMPO_ENDPOINT=tempo-us-central1.grafana.net:443
TEMPO_USERNAME=123456
TEMPO_PASSWORD=glc_xxxxxxxxxxxxx

# Loki (Logs) - Optional
LOKI_ENABLED=false
LOKI_URL=https://logs-us-central1.grafana.net/loki/api/v1/push
LOKI_USERNAME=123456
LOKI_PASSWORD=glc_xxxxxxxxxxxxx

# Application Settings
SERVICE_NAME=farkle-game
ENVIRONMENT=production  # or development, staging, etc.

# Server Configuration
PORT=8080
LOG_LEVEL=info  # debug, info, warn, error

# Local Development (fallback to local Jaeger if Grafana Cloud is disabled)
JAEGER_ENDPOINT=localhost:4318
